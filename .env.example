# Copy to .env for local development. Never commit real values.

SERVICE_NAME=everycred-connector-service
# One of: local, development, staging, production
ENVIRONMENT=local

LOG_LEVEL=INFO
# Use true in deployed environments.
LOG_JSON=false

# API docs are always disabled in production regardless of this flag.
ENABLE_DOCS=true
# JSON list, for example ["https://verifier.example.com"]
CORS_ALLOWED_ORIGINS=[]

# MySQL / MariaDB through the aiomysql driver.
DATABASE_URL=mysql+aiomysql://<user>:<password>@127.0.0.1:3306/everycred_connector?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE_SECONDS=1800

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_CONNECTIONS=100

# Operator key for /v1/sources and /v1/clients (X-Admin-Key). At least
# 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=<random-secret>

# At least 32 characters. Keys the stored HMAC of client API keys;
# changing it invalidates every issued key.
API_KEY_HASH_SECRET=<random-secret>

# At least 32 characters. Keys the hash that replaces holder emails in
# the routing table; changing it orphans every holder link.
HOLDER_KEY_SECRET=<random-secret>

# Comma-separated Fernet keys; the first encrypts, all decrypt. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=<fernet-key>

# Calls to DCS sources.
SOURCE_TIMEOUT_SECONDS=10
SOURCE_MAX_CONCURRENT_CALLS=5

# Signed webhooks from DCS sources older than this are rejected.
WEBHOOK_TOLERANCE_SECONDS=300

# Where credential and request events are forwarded (the holder
# service's POST /v1/connector/events). Leave both unset to only record
# events. The secret must equal the holder service's
# CONNECTOR_WEBHOOK_SECRET; at least 32 characters.
HOLDER_SERVICE_WEBHOOK_URL=
HOLDER_SERVICE_WEBHOOK_SECRET=
NOTIFICATION_TIMEOUT_SECONDS=10
NOTIFICATION_MAX_ATTEMPTS=8
WORKER_INTERVAL_SECONDS=5
